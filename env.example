# Copy to .env and fill in values:
#   cp env.example .env

# ---------------------------------------------------------------------------
# Dashboard (this repo)
# ---------------------------------------------------------------------------

# WebAwesome License Key — https://webawesome.com/
WEBAWESOME_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Security
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging
LOG_LEVEL=INFO

# Optional / future
DATABASE_URL=sqlite:///./dashboard.db

# ---------------------------------------------------------------------------
# Minutes participation + ConCalls ETL (sibling hl7-standards-dev-data repo)
# Export these in the shell before running ETL, or put the same keys in that
# repo's .env if you load dotenv there.
# ---------------------------------------------------------------------------

# Confluence personal access / bearer token (sync / ConfiForms fetch)
CONFLUENCE_TOKEN=

# OpenAI — residual meeting_type classify + LLM attendance extraction
OPENAI_API_KEY=

# Optional model override (defaults in code: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
